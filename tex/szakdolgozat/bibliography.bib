@misc{naffa_biodiversity_2024,
	location = {Rochester, {NY}},
	title = {Biodiversity Risk Premium},
	url = {https://papers.ssrn.com/abstract=4751958},
	doi = {10.2139/ssrn.4751958},
	abstract = {We examine the presence of a biodiversity risk premium ({BRP}) within investment portfolios that incorporate strategies to mitigate biodiversity risks. We construct optimal portfolios from approximately 3,000 companies listed in the {MSCI} All Country World Index, using their {MSCI} biodiversity risk scores as screening criteria. By analysing data from 2013 to 2023, we find that biodiversity-screened portfolios result in lower risk-adjusted returns compared to portfolios comprising randomly selected assets. This suggests the existence of a biodiversity risk premium ranging between 0.9\%-3.6\% of the maximum attainable Sharpe ratios of the universe. The {BRP} remains significant across varying levels of biodiversity risk mitigation, including low, moderate, and high levels, even after controlling for the Fama and French factors, geographic and industry categorisation, additional environmental, social, and governance ({ESG}) factors, and various robustness checks. Our findings shed light on the pricing dynamics of biodiversity risk, contributing to a deeper understanding of how natural capital considerations impact financial markets and investment strategies.},
	number = {4751958},
	publisher = {Social Science Research Network},
	author = {Naffa, Helena and Czupy, Gergely},
	urldate = {2026-02-25},
	date = {2024-03-07},
	langid = {english},
	keywords = {biodiversity risk premium, C61, {ESG} investing, G23, optimal investment portfolios {JEL}: G11, Q20, Q57},
	file = {Full Text PDF:/home/marci/Zotero/storage/DCEFY8JH/Naffa and Czupy - 2024 - Biodiversity Risk Premium.pdf:application/pdf},
}

@misc{lovas_return_2025,
	location = {Rochester, {NY}},
	title = {Return Trade-Offs between Biodiversity Physical and Transition Risk in Global Equity Markets},
	url = {https://papers.ssrn.com/abstract=6085026},
	doi = {10.2139/ssrn.6085026},
	abstract = {We investigate whether biodiversity-related risks are priced in global equity markets by testing whether firms' ecological pressures and dependencies are rewarded or penalized in return. We use firm-and portfolio-level data for over 2,000 global firms from 2019 to 2024, combining {ENCORE} ecosystem service pressure and dependency scores and Principal Adverse Impact ({PAI}) indicators. Our findings show robust evidence of a biodiversity risk premium ({BRP}), demonstrating that both biodiversity physical (dependency-related) and biodiversity transition (pressure-related) risks are significantly priced in by equity markets. Moreover, consistent with prior literature, climate-related factors exhibit even stronger pricing effects; our results, however, reveal the distinct emergence of the {BRP} beyond previously documented findings. Results show that portfolios formed using {ENCORE} scores generate no significant abnormal returns, whereas {PAI}-based portfolios yield a consistent negative alpha for high-pressure firms. This underperformance is more pronounced in Europe and in the post-2022 period, coinciding with the development of {EU} sustainable finance regulations. Results suggest that disclosure frameworks, such as the {EU}'s {PAI}, increase transparency and actively shape capital allocation and risk pricing.},
	number = {6085026},
	publisher = {Social Science Research Network},
	author = {Lovas, Anita and Czupy, Gergely and Naffa, Helena},
	urldate = {2026-02-25},
	date = {2025-11-05},
	langid = {english},
	keywords = {Adverse Impacts, Biodiversity Finance, Biodiversity Risk Premium, Biodiversity Transition Risk, Ecosystem Dependencies, {ESG} Investing},
	file = {Full Text PDF:/home/marci/Zotero/storage/U7FJDBMD/Lovas et al. - 2025 - Return Trade-Offs between Biodiversity Physical and Transition Risk in Global Equity Markets.pdf:application/pdf},
}

@article{fama_five-factor_2015,
	title = {A five-factor asset pricing model},
	volume = {116},
	issn = {0304405X},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0304405X14002323},
	doi = {10.1016/j.jfineco.2014.10.010},
	abstract = {A five-factor model directed at capturing the size, value, profitability, and investment patterns in average stock returns performs better than the three-factor model of Fama and French ({FF}, 1993). The five-factor model's main problem is its failure to capture the low average returns on small stocks whose returns behave like those of firms that invest a lot despite low profitability. The model's performance is not sensitive to the way its factors are defined. With the addition of profitability and investment factors, the value factor of the {FF} three-factor model becomes redundant for describing average returns in the sample we examine.},
	pages = {1--22},
	number = {1},
	journaltitle = {Journal of Financial Economics},
	shortjournal = {Journal of Financial Economics},
	author = {Fama, Eugene F. and French, Kenneth R.},
	urldate = {2026-02-25},
	date = {2015-04},
	langid = {english},
	file = {PDF:/home/marci/Zotero/storage/GR7FJNZK/Fama and French - 2015 - A five-factor asset pricing model.pdf:application/pdf},
}

@misc{giglio_biodiversity_2023,
	location = {Rochester, {NY}},
	title = {Biodiversity Risk},
	url = {https://papers.ssrn.com/abstract=4410107},
	doi = {10.2139/ssrn.4410107},
	abstract = {We explore the effects of physical and regulatory risks related to biodiversity loss on economic activity and asset values. We first develop a news-based measure of aggregate biodiversity risk and analyze how it varies over time. We also construct and publicly release several firm-level measures of exposure to biodiversity risk, based on textual analyses of firms' 10-K statements, the holdings of biodiversity-related funds, and a large survey of finance professionals, regulators, and academics. Exposures to biodiversity risk vary substantially across industries in a way that is economically sensible and distinct from exposures to climate risk. We find evidence that biodiversity risks already affect equity prices: returns of portfolios that are sorted on our measures of biodiversity risk exposure covary positively with innovations in aggregate biodiversity risk. However, our survey indicates that market participants do not perceive the current pricing of biodiversity risks in equity markets to be adequate. We also construct several measures of biodiversity risk exposure across U.S. counties, but find little evidence that those exposures are priced in municipal bond markets.},
	number = {4410107},
	publisher = {Social Science Research Network},
	author = {Giglio, Stefano and Kuchler, Theresa and Stroebel, Johannes and Zeng, Xuran},
	urldate = {2026-02-26},
	date = {2023-04-04},
	langid = {english},
	keywords = {Biodiversity Risk, Johannes Stroebel, {SSRN}, Stefano Giglio, Theresa Kuchler, Xuran Zeng},
	file = {Full Text PDF:/home/marci/Zotero/storage/V636DMIJ/Giglio et al. - 2023 - Biodiversity Risk.pdf:application/pdf},
}

@misc{schrapffer_assessment_2022,
	location = {Rochester, {NY}},
	title = {Assessment of the Double-Materiality of Biodiversity-Related Risks on an Investment Portfolio: Application to the Stoxx 600},
	url = {https://papers.ssrn.com/abstract=4213613},
	doi = {10.2139/ssrn.4213613},
	shorttitle = {Assessment of the Double-Materiality of Biodiversity-Related Risks on an Investment Portfolio},
	abstract = {The worrying deterioration of biodiversity and ecosystems urges us to look closer at their links with human activities and, in particular, economic activities. This is a two-way relationship: economic activities depend, directly or indirectly, on ecosystem services, but they can also harm the ecosystems on which they depend. The question how to address the double materiality of the biodiversity-related risk will be an increasingly pressing issue for all stakeholders. We propose an approach to evaluate the double materiality of biodiversity-related risks on an asset portfolio which will be useful to address the expectations of the market and the requirements of regulations such as Article 29 of the French energy-climate law. For illustrative purposes, this methodology has been applied to a portfolio based on the Stoxx 600 to study the impacts and dependencies on biodiversity of the portfolio as a whole from a sectoral but also from a line-by-line perspective. We estimate that 57.8\% of a portfolio based on the Stoxx 600 has a strong or very strong dependency on biodiversity and that 77.58\% has a strong or very strong impact on biodiversity. In the meanwhile, a Benchmark Portfolio has been constructed based on the Stoxx 600 but, in this case, the holdings are weighted equally. Such a portfolio, is estimated to have 47.83\% of strong or very strong dependency on biodiversity and 64.33\% of strong or very strong impact on biodiversity. The lower dependence and impact on biodiversity shows the importance of the weight of the different holdings in the portfolio. The integrated oil and gas, clothing and electricity sectors are particularly sensitive as they have both a very high dependency and a very high negative impact on biodiversity.},
	number = {4213613},
	publisher = {Social Science Research Network},
	author = {Schrapffer, Anthony and Estran, Rémy and Delzant, Lucie and Paturel, Clara and Ferron, Camille},
	urldate = {2026-03-09},
	date = {2022-09-08},
	langid = {english},
	keywords = {biodiversity, climate energy law, dependencies, ecosystem services, ecosystems, {ESG}, green finance, impacts},
	file = {Full Text PDF:/home/marci/Zotero/storage/5C47E7XT/Schrapffer et al. - 2022 - Assessment of the Double-Materiality of Biodiversity-Related Risks on an Investment Portfolio Appli.pdf:application/pdf},
}

@article{giglio_climate_2021,
	title = {Climate Finance},
	volume = {13},
	issn = {1941-1367, 1941-1375},
	url = {https://www.annualreviews.org/content/journals/10.1146/annurev-financial-102620-103311},
	doi = {10.1146/annurev-financial-102620-103311},
	abstract = {In this article, we review the literature studying interactions between climate change and financial markets. We first discuss various approaches to incorporating climate risk in macrofinance models. We then review the empirical literature that explores the pricing of climate risks across a large number of asset classes, including real estate, equities, and fixed income securities. In this context, we also discuss how investors can use these assets to construct portfolios that hedge against climate risk. We conclude by proposing several promising directions for future research in climate finance.},
	pages = {15--36},
	issue = {Volume 13, 2021},
	journaltitle = {Annual Review of Financial Economics},
	publisher = {Annual Reviews},
	author = {Giglio, Stefano and Kelly, Bryan and Stroebel, Johannes},
	urldate = {2026-03-09},
	date = {2021-11-01},
	langid = {english},
	file = {Full Text:/home/marci/Zotero/storage/VVIREZHI/Giglio et al. - 2021 - Climate Finance.pdf:application/pdf},
}

@article{pastor_dissecting_2022,
	title = {Dissecting green returns},
	volume = {146},
	issn = {0304-405X},
	url = {https://www.sciencedirect.com/science/article/pii/S0304405X22001672},
	doi = {10.1016/j.jfineco.2022.07.007},
	abstract = {Green assets delivered high returns in recent years. This performance reflects unexpectedly strong increases in environmental concerns, not high expected returns. German green bonds outperformed their higher-yielding non-green twins as the “greenium” widened, and U.S. green stocks outperformed brown as climate concerns strengthened. Despite that outperformance, we estimate lower expected returns for green stocks than for brown, consistent with theory. We estimate expected returns in two ways: ex ante, using implied costs of capital, and ex post, using realized returns purged of shocks from climate concerns and earnings. A theoretically motivated green factor explains much of value stocks’ recent underperformance.},
	pages = {403--424},
	number = {2},
	journaltitle = {Journal of Financial Economics},
	shortjournal = {Journal of Financial Economics},
	author = {Pástor, Ľuboš and Stambaugh, Robert F. and Taylor, Lucian A.},
	urldate = {2026-03-09},
	date = {2022-11-01},
	keywords = {{ESG}, Climate change, Environment, Green bonds, Sustainable investing},
	file = {ScienceDirect Full Text PDF:/home/marci/Zotero/storage/VN63ITST/Pástor et al. - 2022 - Dissecting green returns.pdf:application/pdf;ScienceDirect Snapshot:/home/marci/Zotero/storage/E4LT6N9D/S0304405X22001672.html:text/html},
}

@article{garel_investors_2024,
	title = {Do investors care about biodiversity?},
	volume = {28},
	issn = {1572-3097},
	url = {https://doi.org/10.1093/rof/rfae010},
	doi = {10.1093/rof/rfae010},
	abstract = {This article introduces a new measure of a firm’s negative impact on biodiversity, the corporate biodiversity footprint ({CBF}), and studies whether it is priced in an international sample of stocks. On average, the {CBF} does not explain the cross-section of returns between 2019 and 2022. However, a biodiversity footprint premium (higher returns for firms with larger footprints) began emerging in October 2021 after the Kunming Declaration, which capped the first part of the {UN} Biodiversity Conference ({COP}15). Consistent with this finding, stocks with large footprints lost value in the days after the Kunming Declaration. The launch of the Taskforce on Nature-related Financial Disclosures ({TNFD}) in June 2021 had a similar effect. These results indicate that investors have started to require a risk premium upon the prospect of, and uncertainty about, future regulation or litigation to preserve biodiversity.},
	pages = {1151--1186},
	number = {4},
	journaltitle = {Review of Finance},
	shortjournal = {Rev Financ},
	author = {Garel, Alexandre and Romec, Arthur and Sautner, Zacharias and Wagner, Alexander F},
	urldate = {2026-03-09},
	date = {2024-07-01},
	file = {Full Text PDF:/home/marci/Zotero/storage/VG4K26TP/Garel et al. - 2024 - Do investors care about biodiversity.pdf:application/pdf;Snapshot:/home/marci/Zotero/storage/NP7VVSY9/rfae010.html:text/html},
}

@article{sautner_firm-level_2023,
	title = {Firm-Level Climate Change Exposure},
	volume = {78},
	rights = {© 2023 The Authors. The Journal of Finance published by Wiley Periodicals {LLC} on behalf of American Finance Association.},
	issn = {1540-6261},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/jofi.13219},
	doi = {10.1111/jofi.13219},
	abstract = {We develop a method that identifies the attention paid by earnings call participants to firms' climate change exposures. The method adapts a machine learning keyword discovery algorithm and captures exposures related to opportunity, physical, and regulatory shocks associated with climate change. The measures are available for more than 10,000 firms from 34 countries between 2002 and 2020. We show that the measures are useful in predicting important real outcomes related to the net-zero transition, in particular, job creation in disruptive green technologies and green patenting, and that they contain information that is priced in options and equity markets.},
	pages = {1449--1498},
	number = {3},
	journaltitle = {The Journal of Finance},
	author = {Sautner, Zacharias and Van Lent, Laurence and Vilkov, Grigory and Zhang, Ruishen},
	urldate = {2026-03-10},
	date = {2023},
